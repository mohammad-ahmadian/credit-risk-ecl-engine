# (We reuse the helper function from Table 4)
data_period1_fig5 <- get_all_empirical_data(file_path, "2004-01-02", "2015-12-31")
data_period2_fig5 <- get_all_empirical_data(file_path, "2004-01-02", "2025-05-30")
