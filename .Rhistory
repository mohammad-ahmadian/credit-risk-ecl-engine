generate_and_plot_networks(file_path, "2004-01-02", "2025-05-30", "(Jan 2004 – May 2025)")
# --- Execute Part 2: Your Figure 2 Code ---
plot_figure2(T_values = c(250, 500, 750, 1000), title_tag = "Paper Sample-Sizes")
plot_figure2(T_values = c(250, 500, 750, 1000, 1250, 1500), title_tag = "Extended Sample-Sizes")
# --- Execute Part 3: The New Table 1 Simulation ---
# This will take some time to run.
generate_simulation_table(T_values = c(250, 500, 750, 1000), title_tag = "Paper Sample Sizes")
# --- Execute Part 4: Your Empirical Table ---
table1_original <- compute_empirical_table(file_path, "2004-01-02", "2015-12-31")
table1_extended <- compute_empirical_table(file_path, "2004-01-02", "2025-05-30")
final_empirical_table <- rbind(table1_original, table1_extended)
cat("\n--- Final Empirical Network Statistics Table ---\n")
print(kable(final_empirical_table, "pipe") %>% kable_styling(bootstrap_options = "striped", full_width = F))
# --- Execute Part 3: Descriptive Analysis (Figure 3 & Table 2) ---
