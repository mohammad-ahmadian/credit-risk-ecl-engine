generate_descriptive_table(residuals_period1$residuals, residuals_period1$sector_map, "(Jan 2004 – Dec 2015)")
# For the extended time period
residuals_period2 <- get_factor_model_residuals(file_path, "2004-01-02", "2025-05-30")
generate_descriptive_heatmaps(residuals_period2$residuals, residuals_period2$sector_map, "(Jan 2004 – May 2025)")
generate_descriptive_table(residuals_period2$residuals, residuals_period2$sector_map, "(Jan 2004 – May 2025)")
# --- Execute Part 4: The New Figure 4 Code ---
generate_figure4_networks(file_path, "2004-01-02", "2015-12-31", "(Jan 2004 – Dec 2015)")
generate_figure4_networks(file_path, "2004-01-02", "2025-05-30", "(Jan 2004 – May 2025)")
# Generate Table 3 for both periods
table3_original <- generate_table3(file_path, "2004-01-02", "2015-12-31", "(Jan 2004 - Dec 2015)")
table3_extended <- generate_table3(file_path, "2004-01-02", "2025-05-30", "(Jan 2004 - May 2025)")
# --- Execute Part 7: The New Table 4 Code ---
# Prepare the data once for each period to be efficient
data_period1 <- get_all_empirical_data(file_path, "2004-01-02", "2015-12-31")
data_period2 <- get_all_empirical_data(file_path, "2004-01-02", "2025-05-30")
